# ==============================================================================
# ARCHÉON Design Studio — Production Environment Configuration Template
# Copy this file to `.env.production` or `.env` and populate production secrets.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=archeon_db
POSTGRES_USER=archeon_user
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_PORT=5432

# Spring Boot Backend Configuration
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/archeon_db
SPRING_DATASOURCE_USERNAME=archeon_user
SPRING_DATASOURCE_PASSWORD=replace_with_strong_password_in_production
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Security & JWT Tokens (HMAC-SHA256 Base64-encoded secret)
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_ENCRYPTION_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
APP_PORTAL_BASE_URL=https://your-domain.com

# Next.js Frontend Configuration
NODE_ENV=production
PORT=3000
INTERNAL_BACKEND_URL=http://backend:8080
NEXT_PUBLIC_API_URL=/api

# Email & Notification Services (Optional for SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=dsarcheon@gmail.com
SPRING_MAIL_PASSWORD=your_app_password
